# MineAssist-PdM Environment Configuration Example
# Renombra este archivo a .env e introduce tus API Keys

# API Key de OpenAI (Opcional, para explicaciones con GPT-4o-mini)
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# API Key de Google Gemini (Opcional, para explicaciones con Gemini 1.5 Flash)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# API Key de DeepSeek (Opcional, para explicaciones con DeepSeek-V3 o DeepSeek-R1)
# Obtén tu key en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=tu_api_key_de_deepseek_aqui

# API Key de OpenRouter (Opcional, gateway para múltiples modelos)
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui

# URL del Servidor Backend (Por defecto http://localhost:8000)
BACKEND_URL=http://localhost:8000
