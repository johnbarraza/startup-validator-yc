# ── Startup Idea Validation Pipeline — Environment Configuration ─────────────
# Copy this file to .env and fill in your keys.
# Only one provider is required. DeepSeek is the default (cheapest for this use case).

# ── Primary Provider: DeepSeek ───────────────────────────────────────────────
# Get key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# ── Optional: OpenRouter (access to Claude, Qwen, Mistral, Llama, etc.) ──────
# Get key at: https://openrouter.ai/keys
# Use model prefix: openrouter/anthropic/claude-3-haiku, openrouter/qwen/qwen-plus, etc.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Optional: Qwen / DashScope (direct Alibaba API) ──────────────────────────
# Get key at: https://dashscope.aliyuncs.com/
# Use model prefix: qwen/qwen-plus, qwen/qwen-turbo, etc.
DASHSCOPE_API_KEY=your_dashscope_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Optional: OpenAI fallback ─────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# ── Stage-specific model overrides ───────────────────────────────────────────
# Stage 0  — pit classifier, fast + cheap
CLASSIFIER_MODEL=deepseek-v4-flash
# Stage 1+2 — research + gaps, deep analysis
RESEARCH_MODEL=deepseek-v4-pro
# Stage 2B  — idea framings, creative divergent thinking
ITERATION_MODEL=deepseek-v4-pro
# Stage 3C  — dossier + scorecard uses DEEPSEEK_REASONER_MODEL (set to v4-pro above)

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
